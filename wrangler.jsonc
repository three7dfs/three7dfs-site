{
  // Three7 DFS website: the repo's files, served by Cloudflare, plus a small piece of
  // code (src/worker.js) for the optimizer's Premium check at /api/me
  "name": "three7dfs-site",
  "compatibility_date": "2026-11-01",
  "main": "src/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // "off" = beta: everyone gets every feature. "on" = free accounts get 1 lineup etc.
    "PAYWALL": "on",
    // Free week: everyone gets everything, no sign-in, between these two times (Eastern, -05:00).
    // It turns itself on and off; outside these dates PAYWALL above decides. To end early, change FREE_UNTIL.
    "FREE_FROM": "2026-11-24T12:00:00-05:00",
    "FREE_UNTIL": "2026-12-01T00:00:00-05:00",
    "FREE_NOTE": "Free Thanksgiving week",
    "SUPABASE_URL": "https://kalkggzuornbztjnmteh.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_WPS4DKU0oi3C4POq0YeJQg_S1tzYUgB",
    "STRIPE_PAYMENT_LINK": "https://buy.stripe.com/cNi28kbnQ2sm388fHB0Fi00",
    "STRIPE_PORTAL_LINK": "https://billing.stripe.com/p/login/cNi28kbnQ2sm388fHB0Fi00",
    "STRIPE_PRODUCT_ID": "prod_VQmydGlWHCjalM"
    // STRIPE_SECRET_KEY is a secret: Cloudflare dashboard -> three7dfs-site -> Settings -> Variables and Secrets
  }
}
